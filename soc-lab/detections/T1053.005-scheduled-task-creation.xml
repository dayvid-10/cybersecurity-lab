<!--
  Detection: Scheduled task created with schtasks.exe
  ATT&CK:    T1053.005 Scheduled Task/Job: Scheduled Task (Persistence, Execution, Privilege Escalation)
  Source:    Sysmon Event ID 1 (process creation) via Wazuh agent
  Why:       Built-in Wazuh rules only flagged this as generic cmd activity (level 3-4, mapped to T1087).
             Validated with Atomic Red Team T1053.005-2 on WIN11-ENDPOINT, 2026-11-17.
-->
<group name="local,windows,sysmon,persistence,">

  <rule id="100100" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)[/-]create</field>
    <description>Persistence: scheduled task created via schtasks.exe by $(win.eventdata.user): $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

</group>
